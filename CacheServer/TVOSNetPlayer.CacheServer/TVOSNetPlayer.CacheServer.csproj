  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Grpc.AspNetCore" Version="2.80.0" />
    <PackageReference Include="Grpc.Tools" Version="2.80.0" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Protobuf Include="../../Sources/TVOSNetPlayerCacheClient/Protos/tvos_net_player/v1/cache_control.proto" GrpcServices="Both" Link="Protos/cache_control.proto" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="TVOSNetPlayer.CacheServer.Tests" />
  </ItemGroup>

</Project>
